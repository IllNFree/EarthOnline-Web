# OS / 编辑器
.DS_Store
Thumbs.db
*.swp
*~
# 依赖（网页端零依赖，保险起见忽略）
node_modules/
# 本地临时
*.log
.cache/

# 构建产物（构建时自动生成，不入库）
dist/

# 部署用的已构建副本（server.cjs 优先读取，由 npm run predeploy 生成）
webroot/

# 后端本地数据（账号、同步快照、OAuth token、主密钥，绝不入库）
server/data/

# 部署配置（含 EO_MASTER_KEY / SMTP_PASS 等密钥，只保留 example 模板入库）
cloudbase/cloudbaserc.json
cloudbase/.env.local
.env
.env.local

# QA 截图 / 图标设计候选 / 部署缓存（体积大，不入库）
qa/
icon-candidates/
cloudflare/.wrangler/
