{
  "name": "earthonline-web",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "地球Online Web 端 — Vite + Vue 3 + Pinia 重构版 (Glassmorphism PWA)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "node server.cjs",
    "desktop": "electron .",
    "icons": "node tools/gen_icons.mjs",
    "predeploy": "vite build && node -e \"const fs=require('fs');fs.rmSync('webroot',{recursive:true,force:true});fs.cpSync('dist','webroot',{recursive:true})\"",
    "icons:map": "node tools/gen_icon_map.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@microsnow/iconhub": "^0.2.0",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.6.1",
    "grid-layout-plus": "^1.1.1",
    "howler": "^2.2.4",
    "humbleicons": "^1.21.0",
    "makenoise": "^0.1.2",
    "marked": "^18.1.1",
    "motion-v": "^2.8.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.2.6",
    "potrace": "^2.1.8",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
