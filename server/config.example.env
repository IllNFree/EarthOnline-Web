# 复制为 .env 或直接在启动前导出环境变量；不要提交真实密钥。
PORT=8787
HOST=127.0.0.1
# 多实例 / 生产部署时务必固定主密钥（留空则自动生成 server/data/.secret）
EO_MASTER_KEY=
# OAuth 回调用的对外地址
EO_PUBLIC_BASE_URL=http://localhost:8787
# 追加允许的前端 Origin（逗号分隔，默认已含 4173 / 5173 的 localhost 与 127.0.0.1）
EO_ALLOWED_ORIGINS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
